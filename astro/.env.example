# one-click-video-downloader LP — copy to `.env` and fill. NEVER commit `.env`.
# Deployment — `npm run deploy` (scripts/deploy-ftp.mjs). ⛔ FTP only, never SSH
# (shared cPanel account under a process cap: see the script header).

CPANEL_FTP_HOST=<cpanel-host>
CPANEL_FTP_PORT=21

# Prefer a per-directory FTP account chrooted to this docroot (then set
# CPANEL_FTP_SCOPED=true and the docroot follows the credential).
CPANEL_FTP_USER=
CPANEL_FTP_PASSWORD=
CPANEL_FTP_SCOPED=false

# ⛔ This host cannot encrypt FTP; this line states the plaintext choice out loud.
CPANEL_FTP_TLS=false

# Docroot relative to the FTP login's home (used only when not scoped).
CPANEL_DOCROOT_BASE=domains/<account-tree>/juanpablosilva.com.br/one-click-video-downloader

# Optional: read-only ResourceUsage token; gates the deploy on free process slots.
CPANEL_API_TOKEN=
CPANEL_API_USER=<cpanel-account>

CPANEL_SIBLING_SITES=
CPANEL_PROTECT_PATHS=
